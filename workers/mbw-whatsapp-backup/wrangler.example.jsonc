{
  "name": "mbw-whatsapp-test-backup",
  "main": "index.mjs",
  "compatibility_date": "2026-10-06",
  "triggers": { "crons": ["30 11 * * *"] },
  "limits": { "cpu_ms": 1000 },
  "d1_databases": [{ "binding": "MBW_ATTRIBUTION_DB", "database_name": "REPLACE_WITH_EXISTING_INBOX_DATABASE", "database_id": "REPLACE_WITH_EXISTING_DATABASE_ID" }],
  "r2_buckets": [{ "binding": "MBW_WHATSAPP_BACKUPS", "bucket_name": "REPLACE_WITH_PRIVATE_BACKUP_BUCKET" }]
}
