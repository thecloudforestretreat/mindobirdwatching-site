      "parameters":{"jsCode":"const input = $items('Webhook • Guide Recap')[0].json.body || $items('Webhook • Guide Recap')[0].json;\nconst clean = (v,n=500) => String(v ?? '').trim().slice(0,n);\nconst code = clean(input.contributor_number,3);\nif (!/^\\d{3}$/.test(code)) throw new Error('Invalid contributor number');\nconst activeValues = new Set(['true','yes','1','active']);\nconst contributor = $items('Google Sheets • Read Contributors').map(item => item.json || {}).find(row => {\n  const storedCode = clean(row.contributor_number,12).replace(/\\.0+$/,'').padStart(3,'0');\n  return storedCode === code && activeValues.has(clean(row.active,20).toLowerCase());\n});\nif (!contributor) throw new Error('Contributor number not recognized');\nconst now = clean(input.submitted_at,40) || new Date().toISOString();\nconst recapId = clean(input.recap_id,80) || ('recap_' + Date.now());\nconst species = Array.isArray(input.species) ? input.species.slice(0,300) : [];\nif (!species.length) throw new Error('At least one species is required');\nreturn [{json:{recapId,now,contributorId:'contributor_' + code,guideName:clean(contributor.guide_name,120),bookingReference:clean(input.booking_reference,80),tourDate:clean(input.tour_date,10),tourType:clean(input.tour_type,40),routeName:clean(input.route_name,160),notes:clean(input.general_notes,3000),species}}];"},
