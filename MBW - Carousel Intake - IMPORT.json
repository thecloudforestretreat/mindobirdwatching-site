      "id": "1169476d-d6a4-5d30-93bd-2eb37e143e6d",
      "name": "[UPLOAD] Attach Intake Metadata"
    },
    {
      "parameters": {
        "jsCode": "const uploaded = $input.all();\nif (uploaded.length < 2 || uploaded.length > 10) throw new Error(`Expected 2\u201310 completed uploads; received ${uploaded.length}.`);\nconst rows = uploaded.map((item, i) => {\n  const r = item.json;\n  const original = r._intake || {};\n  const secure = String(r.secure_url || '');\n  if (!/^https:\\/\\//.test(secure)) throw new Error(`Cloudinary upload ${i + 1} did not return secure_url.`);\n  return {\n    index: Number(original.image_index || i + 1),\n    url: secure.replace('/upload/', `/upload/${['promotional','infographic','xray'].includes(original.vision_content_type) ? 'c_pad,b_rgb:f7f4e8' : 'c_fill,g_auto'},h_1350,w_1080,q_auto,f_auto/`),\n    original_url: secure,\n    content_type: original.vision_content_type,\n    description: original.vision_description,\n    possible_species: original.possible_species || [],\n    species_confidence: original.species_confidence || 'low',\n    people_visible: original.people_visible === true,\n    promotional_asset: original.promotional_asset === true,\n    suggested_position: original.suggested_position,\n    flags: original.verification_flags || [],\n    context: original,\n  };\n}).sort((a,b) => a.index - b.index);\nconst first = rows[0].context;\nreturn [{ json: {\n  submitted_order: rows,\n  carousel_description: first.carousel_description,\n  known_species: first.known_species,\n  activity_name: first.activity_name,\n  location: first.location,\n  verified_details: first.verified_details,\n  guest_permission_confirmed: first.guest_permission_confirmed,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        120
      ],
      "id": "f4e658e4-a038-5123-ba1b-d9991246bd29",
      "name": "Aggregate Uploaded Images"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: 'qwen3.5:27b', think: false, stream: false, format: 'json', keep_alive: 0,\n  prompt: `Prepare a REVIEW-ONLY carousel intake record from this JSON:\\n${JSON.stringify($json)}\\n\nReturn JSON only with: proposed_order (array containing every supplied image index exactly once), carousel_description, slide_notes (one numbered sentence for each image in proposed order), suggested_featured_birds (array), review_flags (array), ordering_reason.\nRules: preserve user facts; visual species are suggestions only; do not invent locations, tours, guest identities, emotions, permission, dates, rarity, abundance, or sightings. Flag every recognizable person if permission was not confirmed. Keep promotional images clearly labeled.`,\n  options: { temperature: 0.1, num_predict: 900 }\n} }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
