      ],
      "id": "df8909a9-fb2c-57b4-a907-02c98d4e799e",
      "name": "[VISION] Analyze Each Image Locally",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        -600,
        120
      ],
      "id": "ca146ffd-c4bb-581f-bd96-2d5d239f9658",
      "name": "[VISION] Merge Image and Analysis"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const base = item.json;\n  let parsed = {};\n  try { parsed = JSON.parse(String(base.response || '{}').replace(/^```json\\s*|\\s*```$/g, '')); } catch (_) {}\n  const allowed = new Set(['bird','wildlife','guest','landscape','activity','promotional','infographic','xray','other']);\n  return { json: {\n    ...base,\n    vision_content_type: allowed.has(parsed.content_type) ? parsed.content_type : 'other',\n    vision_description: String(parsed.neutral_visual_description || `Image ${base.image_index}`).trim(),\n    possible_species: Array.isArray(parsed.possible_species) ? parsed.possible_species.map(String).slice(0,5) : [],\n    species_confidence: ['low','medium','high'].includes(parsed.species_confidence) ? parsed.species_confidence : 'low',\n    people_visible: parsed.people_visible === true,\n    promotional_asset: parsed.promotional_asset === true,\n    suggested_position: Number(parsed.suggested_position) || base.image_index,\n    verification_flags: Array.isArray(parsed.verification_flags) ? parsed.verification_flags.map(String).slice(0,8) : ['vision_json_parse_failed'],\n  }, binary: item.binary };\n});"
      },
