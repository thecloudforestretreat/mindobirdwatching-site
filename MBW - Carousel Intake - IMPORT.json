        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: 'qwen3.5:27b',\n  prompt: `Analyze image ${$json.image_index} for a Mindo Bird Watching carousel intake.\nUser-supplied context: ${$json.carousel_description}\nKnown species supplied by user: ${$json.known_species || 'None'}\nReturn JSON only with: content_type (bird|wildlife|guest|landscape|activity|promotional|infographic|xray|other), neutral_visual_description, possible_species (array), species_confidence (low|medium|high), people_visible (boolean), promotional_asset (boolean), suggested_position (1-10), verification_flags (array).\nDo not infer location, tour participation, ownership, guest status, permission, rarity, or guaranteed sightings. Treat species names as suggestions unless supplied by the user.`,\n  images: [$json.image_base64], stream: false, think: false, format: 'json', keep_alive: '5m',\n  options: { temperature: 0.1, num_predict: 350 }\n} }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
