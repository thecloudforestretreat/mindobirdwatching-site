      "parameters": {
        "jsCode": "const incoming = $json.body || $json;\nlet body = incoming;\n\n// Mobile-safe requests arrive as a simple form post containing one JSON payload field.\n// JSON requests remain supported for backward compatibility and direct API testing.\nif (typeof incoming.payload === 'string') {\n  try {\n    body = JSON.parse(incoming.payload);\n  } catch (error) {\n    throw new Error('Invalid JSON in form payload.');\n  }\n}\n\nif (!body || typeof body !== 'object' || Array.isArray(body)) {\n  throw new Error('Request body must be a JSON object.');\n}\n\nconst action = String(body.action || '').trim();\nconst now = new Date().toISOString();\n\nif (!action) {\n  throw new Error('Missing action. See allowed_actions in the unsupported-action response.');\n}\n\nreturn [{\n  json: {\n    ...body,\n    action,\n    received_at: now,\n    document_id: '1rdPmYmhCehx_3bI737dkg8NyiutwIu3NAav7B-mbwlw',\n    guests_sheet: 'whatsapp_guests',\n    inquiries_sheet: 'whatsapp_inquiries',\n    operations_document_id: '1_1JtBLyZXpXxTVe11TolZ3Ip2b4ASRDoQaISdHulmFg',\n    interactions_sheet: 'crm_interactions',\n    assignments_sheet: 'crm_assignments',\n    providers_sheet: 'crm_providers',\n    accounting_document_id: '1ckRUChk3pp4QlO1BIDkOeF8CIwHBidYbBmjb39dbGIU',\n    accounting_source_sheet: 'stripe_invoices'\n  }\n}];"
